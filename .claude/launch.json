{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bleiben-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "frontend/build/web"
      ],
      "port": 5180,
      "url": "http://127.0.0.1:5180"
    },
    {
      "name": "bleiben-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && set USE_LOCAL_STORE=1&& set DATA_FILE=./data/e2e-local.json&& node src/index.js"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "bleiben-api-mvp",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && set PORT=8790&& set APP_BASE_URL=http://127.0.0.1:5181&& set API_BASE_URL=http://127.0.0.1:8790&& node scripts/mvp-test-server.mjs"
      ],
      "port": 8790,
      "url": "http://127.0.0.1:8790",
      "autoPort": false
    },
    {
      "name": "bleiben-web-mvp",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5181",
        "--bind",
        "127.0.0.1",
        "--directory",
        "frontend/build/web-mvp"
      ],
      "port": 5181,
      "url": "http://127.0.0.1:5181"
    }
  ]
}