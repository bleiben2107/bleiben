PORT=8000
APP_NAME=Bleiben
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATA_FILE=./data/bleiben.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MONGODB_URI=
MONGODB_DB=bleiben

# Where the Flutter web app runs (used in invite emails)
APP_BASE_URL=http://127.0.0.1:5180

# Email via SMTP (e.g. Brevo: smtp-relay.brevo.com:587). Leave blank to log
# emails to the console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bleiben <team@example.com>

# SMS provider for phone OTP (not integrated yet; codes are logged in dev)
SMS_PROVIDER=
